{
    "name": "datatables.net-colreorder-dt",
    "description": "ColReorder for DataTables with styling for [DataTables](https://datatables.net/)",
    "main": "./js/colReorder.dataTables.js",
    "module": "./js/colReorder.dataTables.mjs",
    "style": "./css/colReorder.dataTables.css",
    "types": "./types/colReorder.dataTables.d.ts",
    "version": "3.1.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "ColReorder",
        "Reorder",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-colreorder": "3.1.1",
        "datatables.net-dt": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/ColReorder.git"
    },
    "exports": {
        ".": {
            "types": "./types/colReorder.dataTables.d.ts",
            "import": "./js/colReorder.dataTables.mjs",
            "default": "./js/colReorder.dataTables.mjs",
            "require": "./js/colReorder.dataTables.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/colReorder.dataTables.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}